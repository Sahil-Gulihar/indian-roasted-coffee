---
import Header from '../components/uswds/Header.astro';
import Footer from '../components/uswds/Footer.astro';
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { siteConfig } from '../config/site';
import { absUrl, clip, DEFAULT_OG_IMAGE } from '../utils/seo';

// Self-hosted fonts (CSP allows font-src 'self' only)
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/questrial/400.css';

// Global styles — USWDS first, then the site design system on top
import '../styles/uswds-theme.scss';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Canonical URL for this page */
  canonicalUrl?: string;
  /** Open Graph image (site path or absolute URL) */
  ogImage?: string;
  ogType?: 'website' | 'product';
  /** schema.org JSON-LD for this page */
  jsonLd?: object;
  /** Set true on dev-only pages to block search engine indexing */
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  locale = 'en',
  canonicalUrl,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;

const t = useTranslations(locale);
const lang = locale;
const pageTitle = title === siteConfig.name || `${title} | ${siteConfig.name}`.length > 60
  ? title
  : `${title} | ${siteConfig.name}`;
const metaDescription = clip(description, 160);
// Strip the base prefix so Header nav/toggle logic works on base-relative paths
const basePath = base.slice(0, -1); // '/astro-gov-starter/' -> '/astro-gov-starter'
const rawPath = Astro.url.pathname;
const currentPath = basePath && rawPath.startsWith(basePath)
  ? rawPath.slice(basePath.length) || '/'
  : rawPath;

// Absolute URLs for canonical/hreflang/og — include the base path so
// subpath deployments (e.g. GitHub Pages project sites) emit correct URLs
const siteOrigin = `https://${siteConfig.domain}`;
const enPath = currentPath.replace(/^\/es/, '') || '/';
const esPath = `/es${currentPath.startsWith('/es') ? currentPath.replace(/^\/es/, '') : currentPath}`;
const pageUrl = `${siteOrigin}${basePath}${currentPath}`;
const resolvedCanonical = canonicalUrl ?? pageUrl;
const ogLocale = locale === 'es' ? 'es_US' : 'en_IN';
const ogLocaleAlternate = locale === 'es' ? 'en_IN' : 'es_US';
const ogImageUrl = absUrl(ogImage);
// Only routes under src/pages/[...lang]/ have a Spanish version.
const hasEsVersion = /^\/(es\/)?((about|accessibility|contact|glossary|privacy|returns|search|terms|wholesale)\/|products\/([^/]+\/)?)?$/.test(currentPath);

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {!noindex && <link rel="canonical" href={resolvedCanonical} />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:locale" content={ogLocale} />
    {hasEsVersion && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Alternate languages -->
    {hasEsVersion && <link rel="alternate" hreflang="en" href={`${siteOrigin}${basePath}${enPath}`} />}
    {hasEsVersion && <link rel="alternate" hreflang="es" href={`${siteOrigin}${basePath}${esPath}`} />}

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>

  <body>
    <a class="skipnav" href="#main-content">{t('nav.skipToMain')}</a>

    <Header locale={locale} currentPath={currentPath} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <!-- USWDS JavaScript for accordion, banner, and nav behaviors.
         Served from public/uswds/js/ — copied by scripts/setup-uswds.mjs. -->
    <script src={`${base}uswds/js/uswds.min.js`} is:inline defer></script>
  </body>
</html>
